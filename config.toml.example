# JIRA接続設定
[jira]
# JIRA Cloud URL (例: https://your-domain.atlassian.net)
url = "https://your-domain.atlassian.net"

# オンプレJIRA ServerのURL（移行元、オプション）
# 設定すると、このURLを含む課題リンクもサイト内相対リンクに変換される
# 例: http://jira.example.com/browse/SCRUM-1 → [SCRUM-1](../scrum-1/)
# server_url = "http://jira.internal.example.com"

# JIRAユーザーのメールアドレス
email = "your-email@example.com"

# JIRA API Token
# 取得方法: https://id.atlassian.com/manage-profile/security/api-tokens
api_token = "your-api-token-here"

# 出力設定
[output]
# Markdown出力ディレクトリ
markdown_dir = "output/markdown"

# 旧添付ファイル保存ディレクトリ（convertコマンドでの旧データ移行用、通常は不要）
# 添付ファイルは各課題のディレクトリ（index.mdと同じ場所）に保存されます
# attachments_dir = "output/attachments"

# JSON出力ディレクトリ（APIレスポンスをJSONで保存、空の場合は保存しない）
# convertコマンドでJSONからMarkdownを再生成する際に使用
json_dir = "output/json"

# 検索設定
[search]
# デフォルトのJQLクエリ（searchコマンドで--queryを省略した場合に使用）
default_jql = "project = PROJ ORDER BY created DESC"

# 開発情報詳細取得の設定（オプション）
[development]
# ブランチ名やPR名などの詳細情報を取得する（デフォルト: false）
enabled = false
# 使用している開発ツール: "github", "bitbucket", "stash"
application_type = "bitbucket"
# API種別: "rest"（従来）または "graphql"（新規）
# "rest": /rest/dev-status/1.0/issue/detail を使用（従来方式、安定している）
# "graphql": /jsw2/graphql を使用（新規方式、より多くの情報を一度に取得可能）
# デフォルト: "rest"
api_type = "rest"

# 表示設定（オプション）
[display]
# 基本情報セクションで非表示にするカスタムフィールドIDのリスト
# 例：Start date (customfield_10015), Rank (customfield_10019)
hidden_custom_fields = [
    "customfield_10015",
    "customfield_10019"
]
# RankフィールドのカスタムフィールドID（デフォルト: customfield_10019）
# JIRAインスタンスによってRankのフィールドIDが異なる場合に変更
rank_field_id = "customfield_10019"

# Start dateフィールドのカスタムフィールドID（デフォルト: customfield_10015）
# JIRAインスタンスによってStart dateのフィールドIDが異なる場合に変更
start_date_field_id = "customfield_10015"

# Confluence関連設定（オプション）
[confluence]
# Confluenceリンクで無視するタイトルのリスト
# このリストに含まれるタイトルは空と同じ扱いにされ、URLそのものが表示される
# 例：「Page」「Wiki Page」のような汎用的なタイトルなど
ignored_titles = [
]

# URLプレフィックス置換（オプション）
# "置換前URLプレフィックス" = "置換後URLプレフィックス" の形式で設定（パス部分は保持される）
# 複数設定可能
# 用途例: オンプレの社内WikiをConfluence Cloudに移行した場合のURL更新など
#
# [url_replacements]
# "http://wiki.internal.example.com" = "https://yourcompany.atlassian.net/wiki"
# "http://old.example.com"           = "https://new.example.com"

# 削除済みユーザーのマッピング（オプション）
# accountTypeが"unknown"の場合（退職等でアカウント削除済み）にaccountIdで名前を解決
[deletedUsers]
# "accountId" = "表示名" の形式で設定
# 例: "557058:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" = "山田 太郎"
